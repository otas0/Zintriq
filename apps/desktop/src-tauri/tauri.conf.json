{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zintriq",
  "version": "0.1.0",
  "identifier": "com.zintriq.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Zintriq", "width": 1280, "height": 800 }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb"]
  }
}
