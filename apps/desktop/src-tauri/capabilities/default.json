{
  "identifier": "default",
  "description": "Default window permissions — FS scope starts empty; allow_project_dir adds the opened folder only",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": []
    }
  ]
}
