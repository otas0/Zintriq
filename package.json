{
  "name": "zintriq",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/run-workspace.mjs build",
    "typecheck": "node scripts/run-workspace.mjs build && node scripts/run-workspace.mjs typecheck",
    "test": "node scripts/run-workspace.mjs build && node scripts/run-workspace.mjs test",
    "lint": "node scripts/run-workspace.mjs build && node scripts/run-workspace.mjs lint",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:electron": "node scripts/verify-electron.mjs",
    "smoke:clangd": "node scripts/clangd-stdio-smoke.mjs",
    "smoke:tauri-four-step": "node scripts/tauri-four-step-smoke.mjs",
    "e2e:tauri-webdriver": "node scripts/tauri-webdriver-four-step.mjs",
    "test:sha256sums": "python3 -m unittest desktop.packaging.test_sha256sums",
    "test:size-guard": "bash scripts/test-size-guard-fixture.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
