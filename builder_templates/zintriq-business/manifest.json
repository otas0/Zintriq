{
  "id": "zintriq-business",
  "name": "Business App",
  "description": "Business-facing Interface: workspace ops, store manager, team, CRM, bookings, workflows and analytics. Separate from the Customer App template.",
  "publisher": "Zintriq",
  "version": 1,
  "schema_version": 4,
  "package_type": "template",
  "template_kind": "application",
  "source": "core",
  "visibility": "official",
  "marketplace_ready": true,
  "community_category": "Business applications",
  "dependencies": [],
  "required_capabilities": ["core", "navigation", "forms", "data", "auth", "commerce", "booking", "survey", "feedback", "check_in", "events", "crm", "contacts", "analytics", "notifications", "qr", "payments", "workflows"],
  "permissions": ["builder.read", "builder.create", "builder.update", "builder.publish"],
  "compatibility": {"builder_schema": ">=2 <5", "legacy_routes": true, "strangler_migration": true, "creator_system": true},
  "assets": [],
  "components": ["core/navigation", "core/app_shell", "core/app_module", "core/header"],
  "component_definitions": [],
  "design_system": {
    "tokens": ["color.brand.primary", "color.background", "color.surface", "color.text", "color.text.muted", "space.sm", "space.md", "space.lg", "radius.card", "shadow.standard", "duration.fast", "duration.normal", "easing.standard"],
    "theme_modes": ["light", "dark"]
  },
  "project_variables": ["brand.name", "content.maxWidth", "layout.pagePadding"],
  "data_sources": ["commerce.stores", "commerce.products", "workspace.current"],
  "app_modules": ["commerce.store_manager", "booking.manager", "analytics.dashboard"],
  "workflows": ["bos.workflows", "qr_experience_workflow"],
  "runtime_adapters": ["hybrid_strangler", "universal_native", "controlled_module_host", "flask_legacy_bridge"],
  "migrations": [
    {"id": "native-business-shell", "mode": "hybrid_document", "route": "/app/store", "reversible": true}
  ],
  "runtime": {
    "adapter": "hybrid_strangler",
    "preserve_existing_routes": true,
    "preserve_existing_data": true,
    "public_url": "/app/store"
  },
  "surfaces": [
    {
      "id": "business-site",
      "name": "Business Site",
      "audience": "business",
      "routes": ["/app/*", "/manage/*", "/business/*"]
    }
  ],
  "documents": [
    {"key": "business-site", "name": "Business App", "type": "application", "route": "/app/store", "adapter": "universal_native", "migration_status": "hybrid", "legacy_adapter": "bos_shell", "slug_owner": "template"},
    {"key": "visual-builder", "name": "Universal Visual Builder", "type": "builder", "route": "/manage/{store}/landing-qr", "adapter": "visual_builder"},
    {"key": "operations", "name": "Business Operations", "type": "application", "route": "/app/store", "adapter": "bos_platforms"},
    {"key": "automation", "name": "Workflows and Automation", "type": "workflow", "route": "/app/workflows", "adapter": "workflow_platform"}
  ],
  "legacy_adapters": [
    "feedback_platform",
    "feedback_core_platform",
    "mvp_responses_platform",
    "qr_experience_platform",
    "qr_experience_analytics",
    "qr_experience_templates",
    "qr_experience_workflow",
    "qr_customer_data",
    "business_help_platform",
    "workspace_platform",
    "workflow_platform",
    "bos_modules_platform",
    "team_platform",
    "task_platform",
    "contact_platform",
    "booking_platform",
    "checkin_platform",
    "calendar_platform",
    "home_platform",
    "integration_platform",
    "integrations_core",
    "payment_connect_plugin",
    "reputation_connect_plugin",
    "merchant_phone_auth"
  ],
  "capabilities": [
    "authentication",
    "business_workspaces",
    "stores",
    "catalog",
    "qr_generation",
    "qr_analytics",
    "visual_editor",
    "drafts",
    "revisions",
    "publishing",
    "rollback",
    "feedback",
    "surveys",
    "booking",
    "check_in",
    "events",
    "customer_data",
    "contacts",
    "teams",
    "tasks",
    "calendar",
    "workflows",
    "integrations",
    "analytics",
    "notifications",
    "permissions",
    "responsive_business_site",
    "payments",
    "reputation",
    "phone_authentication"
  ]
}
