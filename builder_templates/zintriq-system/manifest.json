{
  "id": "zintriq-system",
  "name": "Business & Customer App (deprecated)",
  "description": "Deprecated umbrella. Use separate official templates: Customer App (zintriq-customer) and Business App (zintriq-business).",
  "publisher": "Zintriq",
  "version": 4,
  "schema_version": 4,
  "package_type": "template",
  "template_kind": "application",
  "source": "core",
  "visibility": "official",
  "marketplace_ready": false,
  "community_category": "Business applications",
  "dependencies": [],
  "required_capabilities": [
    "core",
    "navigation",
    "forms",
    "data",
    "auth",
    "commerce",
    "booking",
    "survey",
    "feedback",
    "check_in",
    "events",
    "crm",
    "contacts",
    "analytics",
    "notifications",
    "qr",
    "payments",
    "workflows"
  ],
  "permissions": [
    "builder.read",
    "builder.create",
    "builder.update",
    "builder.publish"
  ],
  "compatibility": {
    "builder_schema": ">=2 <5",
    "legacy_routes": true,
    "strangler_migration": true,
    "creator_system": true
  },
  "assets": [],
  "components": [
    "core/navigation",
    "core/hero",
    "core/store_grid",
    "core/booking",
    "core/survey",
    "core/app_shell",
    "core/app_module",
    "core/shop",
    "core/check_in",
    "core/contact"
  ],
  "component_definitions": [
    "official.product-card"
  ],
  "design_system": {
    "tokens": [
      "color.brand.primary",
      "color.background",
      "color.surface",
      "color.text",
      "color.text.muted",
      "space.sm",
      "space.md",
      "space.lg",
      "radius.card",
      "shadow.standard",
      "duration.fast",
      "duration.normal",
      "easing.standard"
    ],
    "theme_modes": [
      "light",
      "dark"
    ]
  },
  "project_variables": [
    "brand.name",
    "content.maxWidth",
    "layout.pagePadding"
  ],
  "data_sources": [
    "commerce.stores",
    "commerce.products",
    "workspace.current"
  ],
  "app_modules": [
    "commerce.store_manager",
    "booking.manager",
    "analytics.dashboard"
  ],
  "workflows": [
    "bos.workflows",
    "qr_experience_workflow"
  ],
  "runtime_adapters": [
    "hybrid_strangler",
    "universal_native",
    "controlled_module_host",
    "flask_legacy_bridge"
  ],
  "migrations": [
    {
      "id": "wrap-existing-system",
      "mode": "additive",
      "reversible": true
    },
    {
      "id": "native-customer-home",
      "mode": "hybrid_document",
      "route": "/",
      "reversible": true
    },
    {
      "id": "native-business-shell",
      "mode": "hybrid_document",
      "route": "/app/store",
      "reversible": true
    },
    {
      "id": "creator-system-foundation",
      "mode": "additive",
      "reversible": true
    },
    {
      "id": "split-customer-business-templates",
      "mode": "additive",
      "reversible": true
    }
  ],
  "runtime": {
    "adapter": "hybrid_strangler",
    "preserve_existing_routes": true,
    "preserve_existing_data": true
  },
  "surfaces": [
    {
      "id": "customer-site",
      "name": "Customer Site",
      "audience": "customer",
      "routes": [
        "/",
        "/home",
        "/places",
        "/venues",
        "/store/*",
        "/account",
        "/help/*",
        "/e/*",
        "/qr/*"
      ]
    },
    {
      "id": "business-site",
      "name": "Business Site",
      "audience": "business",
      "routes": [
        "/app/*",
        "/manage/*",
        "/business/*"
      ]
    }
  ],
  "documents": [
    {
      "key": "customer-site",
      "name": "Customer Home",
      "type": "site",
      "route": "/",
      "adapter": "universal_native",
      "migration_status": "hybrid",
      "legacy_adapter": "customer_platform",
      "slug_owner": "template",
      "aliases": [
        "/home"
      ]
    },
    {
      "key": "business-site",
      "name": "Business App",
      "type": "application",
      "route": "/app/store",
      "adapter": "universal_native",
      "migration_status": "hybrid",
      "legacy_adapter": "bos_shell",
      "slug_owner": "template"
    },
    {
      "key": "storefront",
      "name": "Storefront",
      "type": "commerce",
      "route": "/store/{slug}",
      "adapter": "storefront_platform"
    },
    {
      "key": "qr-runtime",
      "name": "QR and Scan Runtime",
      "type": "runtime",
      "route": "/qr/{code}",
      "adapter": "qr_experience_runtime"
    },
    {
      "key": "visual-builder",
      "name": "Universal Visual Builder",
      "type": "builder",
      "route": "/manage/{store}/landing-qr",
      "adapter": "visual_builder"
    },
    {
      "key": "operations",
      "name": "Business Operations",
      "type": "application",
      "route": "/app/store",
      "adapter": "bos_platforms"
    },
    {
      "key": "customer-data",
      "name": "Customer Data",
      "type": "data_model",
      "route": "",
      "adapter": "customer_platform"
    },
    {
      "key": "automation",
      "name": "Workflows and Automation",
      "type": "workflow",
      "route": "/app/workflows",
      "adapter": "workflow_platform"
    }
  ],
  "legacy_adapters": [
    "feedback_platform",
    "feedback_core_platform",
    "mvp_responses_platform",
    "qr_experience_platform",
    "qr_experience_runtime",
    "qr_experience_analytics",
    "qr_experience_templates",
    "qr_experience_workflow",
    "qr_customer_data",
    "customer_platform",
    "help_platform",
    "business_help_platform",
    "workspace_platform",
    "event_platform",
    "workflow_platform",
    "bos_modules_platform",
    "team_platform",
    "task_platform",
    "contact_platform",
    "booking_platform",
    "checkin_platform",
    "calendar_platform",
    "home_platform",
    "integration_platform",
    "integrations_core",
    "payment_connect_plugin",
    "reputation_connect_plugin",
    "checkout_platform",
    "mobile_platform",
    "legal_platform",
    "customer_account_platform",
    "i18n_platform",
    "merchant_phone_auth"
  ],
  "capabilities": [
    "authentication",
    "customer_accounts",
    "business_workspaces",
    "customer_business_mode_switching",
    "stores",
    "catalog",
    "storefront",
    "cart",
    "checkout",
    "orders",
    "qr_generation",
    "qr_scanning",
    "qr_analytics",
    "visual_editor",
    "drafts",
    "revisions",
    "publishing",
    "rollback",
    "multilingual_content",
    "feedback",
    "surveys",
    "booking",
    "check_in",
    "events",
    "digital_business_cards",
    "customer_data",
    "contacts",
    "teams",
    "tasks",
    "calendar",
    "workflows",
    "integrations",
    "analytics",
    "notifications",
    "permissions",
    "responsive_customer_site",
    "responsive_business_site",
    "payments",
    "reputation",
    "mobile_app_support",
    "legal_and_consent",
    "help_center",
    "phone_authentication",
    "internationalization"
  ],
  "deprecated": true,
  "replaced_by": [
    "zintriq-customer",
    "zintriq-business"
  ]
}
