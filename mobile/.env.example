# Copy to .env.local (repo root) before building mobile apps:
#
# PUBLIC_BASE_URL=https://your-domain.com
# MOBILE_SERVER_URL=https://your-domain.com
#
# Local dev (phone on same Wi‑Fi — use your Mac's LAN IP, not 127.0.0.1):
# MOBILE_SERVER_URL=http://192.168.1.42:5001
#
# Android emulator → host machine:
# MOBILE_SERVER_URL=http://10.0.2.2:5001
