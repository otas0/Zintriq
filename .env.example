# Zintriq Editor (local desktop host)
ZINTRIQ_DESKTOP=1
# ZINTRIQ_DESKTOP_TOKEN is generated by Electron; do not commit secrets.
# ZINTRIQ_DATA_DIR=
# ZINTRIQ_WORKSPACE=
# ZINTRIQ_PYTHON=
# PORT=8765

# Real model (OpenAI-compatible). Requires permissions: ai.run + network.
# ZINTRIQ_AI_API_KEY=
# ZINTRIQ_AI_BASE_URL=https://api.openai.com/v1
# ZINTRIQ_AI_MODEL=gpt-4o-mini

# LSP servers on PATH (optional): pyright-langserver, typescript-language-server
