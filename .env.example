# Copy to .env.local for local dev, or set these in your host's environment for production.
# .env.local is gitignored — never commit real secrets.

# --- Required for production ---
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-domain.com

# HTTPS: set true when served over TLS (required for secure session cookies)
SESSION_COOKIE_SECURE=true

# --- Identity (Auth0 / Okta) + database (AWS RDS Postgres) ---
# Production: set AUTH_PROVIDER=auth0 and DATABASE_URL. Local default is SQLite + local passwords.
# AUTH_PROVIDER=auth0
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_CALLBACK_URL=https://your-domain.com/auth/callback
# AUTH0_LOGOUT_RETURN_TO=https://your-domain.com/
# DATABASE_URL=postgresql://zintriq:PASSWORD@….eu-central-1.rds.amazonaws.com:5432/zintriq?sslmode=require
# Aurora Express / IAM-only clusters (no static DB password):
# DATABASE_IAM_AUTH=1
# AWS_REGION=ap-southeast-2
# DATABASE_URL=postgresql://postgres@….rds.amazonaws.com:5432/zintriq?sslmode=require
# SQLITE_PATH=  # optional override; default ./marketqr.db when DATABASE_URL unset

# --- Zintriq Studio (desktop/native composition shell) ---
# MVP AI Builder shell (prompt → webpage). Default on when ZINTRIQ_DESKTOP=1; set 0 for full Workbench.
# ZINTRIQ_MVP_AI_BUILDER=1
# Deep link scheme for Community → Studio handoff (default zintriq)
# STUDIO_DEEP_LINK_SCHEME=zintriq
# Auth0 Native application (PKCE, Token Endpoint Auth = None, callback zintriq://auth/callback)
# AUTH0_NATIVE_CLIENT_ID=
# Published installers for /download (after `cd desktop && npm run dist`)
# SITE_STAGE=2
# STUDIO_LATEST_VERSION=0.1.0
# Directory of electron-updater files (latest-mac.yml, dmg, exe, AppImage) served at /desktop/updates/
# STUDIO_UPDATE_DIR=/var/zintriq/studio-updates
# STUDIO_DOWNLOAD_MAC_URL=https://releases.example.com/Zintriq-Studio.dmg
# STUDIO_DOWNLOAD_WIN_URL=https://releases.example.com/Zintriq-Studio-Setup.exe
# STUDIO_DOWNLOAD_LINUX_URL=https://releases.example.com/Zintriq-Studio.AppImage
# Capacitor / mobile shell should open /studio (not /app). See docs/MOBILE_APPS.md and desktop/README.md

# --- Cloudflare Turnstile (bot CAPTCHA on login/register; not Google reCAPTCHA) ---
# Dashboard → Turnstile → Add site → copy site/secret keys.
# Local always-pass test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_REQUIRED=1  # fail closed even if keys missing (production hardening)

# --- SMTP (transactional email) ---
# Without SMTP_HOST, emails are skipped and links are logged to the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="zintriq <noreply@your-domain.com>"
SMTP_USE_TLS=1
# Use SMTP_USE_SSL=1 with port 465 instead of STARTTLS (e.g. some SES setups)
# SMTP_USE_SSL=0

# Legal / privacy contact shown on /legal/* pages and imprint
LEGAL_CONTACT_EMAIL=zintriq@gmail.com
# Google / YouTube Brand product integrations are not offered.

# Optional: destination for scripts/verify_smtp.py smoke test
# SMTP_TEST_TO=you@example.com

# --- Review platform OAuth (optional — owner connects business account in Settings) ---
# YELP_CLIENT_ID=
# YELP_CLIENT_SECRET=
# TRIPADVISOR_CLIENT_ID=
# TRIPADVISOR_CLIENT_SECRET=
# TABLELOG_CLIENT_ID=
# TABLELOG_CLIENT_SECRET=
# OPENTABLE_CLIENT_ID=
# OPENTABLE_CLIENT_SECRET=
# Demo connect removed. Credentials must pass live provider verification.
# Google Reviews / Customer Reviews / Pay integrations are not offered.

# --- Zintriq SaaS subscriptions (portal; company + Stripe products first) ---
# Stripe Checkout in Flask. Default off. Do not reuse merchant STRIPE_SECRET_KEY.
# Create test Products/Prices in Dashboard (test mode), then put IDs in .env.local:
# Cloud subscription (Publish & sync). Local make/export never require this.
# BILLING_ENABLED=1
# ZINTRIQ_STRIPE_SECRET_KEY=sk_test_...
# ZINTRIQ_STRIPE_WEBHOOK_SECRET=whsec_...
# ZINTRIQ_STRIPE_PRICE_PERSONAL=price_...
# ZINTRIQ_STRIPE_PRICE_TEAM=price_...
# Live keys (sk_live_) also need ZINTRIQ_STRIPE_LIVE=1. Keep that off until you intend to charge.
# Webhook path: POST /webhooks/stripe-billing
# Entitlement read (logged-in cookie): GET /billing/status
# Desktop bearer entitlement: GET /api/desktop/cloud/entitlement
# Hosted share HTML: GET /w/<public_id> (after Publish; gated when BILLING_ENABLED=1)
# Local webhook (Stripe CLI): stripe listen --forward-to 127.0.0.1:5001/webhooks/stripe-billing
# Customer Portal (cancel / switch plan): Dashboard → Settings → Billing → Customer portal.
# Optional: ZINTRIQ_STRIPE_PORTAL_CONFIGURATION=bpc_...

# --- Payments: each merchant connects their own keys in Settings (no platform .env required) ---
# Optional platform OAuth (only if you register a Connect app later):
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_SECRET_KEY=
#
# Merchants paste keys in Settings → Integrations:
#   Stripe: sk_test_… / sk_live_… from dashboard.stripe.com/apikeys
#   PayPal: REST app Client ID + Secret from developer.paypal.com (Sandbox first)
#   PayPay: merchant API credentials from PayPay portal
# PAYPAY_CLIENT_ID=
# PAYPAY_CLIENT_SECRET=
# PAYPAY_MODE=sandbox
# Credentials must pass live provider API verification (demo connect removed).
# Platform take rate on checkout (basis points — 150 = 1.5%, hard cap)
# PLATFORM_TAKE_RATE_BPS=150
# PLATFORM_TAKE_RATE_MAX_BPS=150
# PLATFORM_FEE_CAP_USD=50
# Leave unset (or 0) for no cap. Examples: 50 = $50 max per order.

# --- Server ---
PORT=5001
HOST=0.0.0.0
