{
  "name": "zintriq-studio",
  "productName": "Zintriq Studio",
  "version": "0.1.0",
  "description": "Zintriq Studio — desktop factory (describe, simulate, instantiate, boundary)",
  "main": "main.js",
  "author": {
    "name": "Zintriq",
    "email": "support@zintriq.com"
  },
  "homepage": "https://zintriq.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "smoke": "node scripts/smoke.js",
    "pack": "node packaging/run-builder.js --dir --publish never",
    "dist": "node packaging/run-builder.js --publish never",
    "dist:mac": "node packaging/run-builder.js --mac --publish never",
    "dist:win": "node packaging/run-builder.js --win --publish never",
    "dist:linux": "node packaging/run-builder.js --linux --publish never",
    "sign:mac-adhoc": "sh packaging/sign_macos_adhoc.sh"
  },
  "build": {
    "appId": "com.zintriq.studio",
    "productName": "Zintriq Studio",
    "copyright": "Copyright \u00a9 Zintriq",
    "asar": true,
    "afterSign": "packaging/notarize.js",
    "protocols": [
      {
        "name": "Zintriq Studio",
        "schemes": [
          "zintriq"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "zintriq.json",
        "name": "Zintriq description",
        "role": "Editor"
      },
      {
        "ext": "zintriq-app",
        "name": "Zintriq app pack",
        "description": "Local Zintriq app pack. Not a store installer.",
        "role": "Editor",
        "mimeType": "application/zip"
      },
      {
        "ext": "json",
        "name": "Zintriq stamp pack",
        "description": "Local stamp JSON. Not a third-party JS view.",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/json"
      },
      {
        "ext": "zintriq-plugin.json",
        "name": "Zintriq plugin stamp",
        "description": "Official or reviewed stamp. Open in Studio. Not default unzip.",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/json"
      },
      {
        "ext": "zip",
        "name": "Zintriq webpage pack",
        "description": "Zintriq webpage zip or .zintriq-app.zip. Alternate, not default unzip.",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/zip"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "main.js",
      "preload.js",
      "auth.js",
      "flask_host.js",
      "app_menu.js",
      "meta_zip_host.js",
      "meta_http.js",
      "navigation.js",
      "cloud_host.js",
      "updater.js",
      "account_origin.js",
      "host_prefs.js",
      "error.html",
      "login.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/zintriq-server",
        "to": "zintriq-server"
      },
      {
        "from": "resources/notices",
        "to": "notices"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "packaging/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "mimeTypes": ["application/json", "application/zip"],
      "synopsis": "Zintriq Studio",
      "executableArgs": [],
      "maintainer": "Zintriq <support@zintriq.com>"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://zintriq.com/desktop/updates"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
