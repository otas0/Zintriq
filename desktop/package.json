{
  "name": "zintriq-studio",
  "productName": "Zintriq Studio",
  "version": "0.1.0",
  "description": "Zintriq Studio \u2014 desktop composition app (Data, Interface, Logic, Connection, Publish)",
  "main": "main.js",
  "author": {
    "name": "Zintriq",
    "email": "support@zintriq.com"
  },
  "homepage": "https://zintriq.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "smoke": "node scripts/smoke.js",
    "pack": "node packaging/run-builder.js --dir",
    "dist": "node packaging/run-builder.js",
    "dist:mac": "node packaging/run-builder.js --mac",
    "dist:win": "node packaging/run-builder.js --win",
    "dist:linux": "node packaging/run-builder.js --linux",
    "sign:mac-adhoc": "sh packaging/sign_macos_adhoc.sh"
  },
  "build": {
    "appId": "com.example.zintriq.unreleased",
    "productName": "Zintriq Studio",
    "copyright": "Copyright \u00a9 Zintriq",
    "asar": true,
    "protocols": [
      {
        "name": "Zintriq Studio",
        "schemes": [
          "zintriq"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "main.js",
      "preload.js",
      "auth.js",
      "flask_host.js",
      "transfer_host.js",
      "error.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/zintriq-server",
        "to": "zintriq-server"
      },
      {
        "from": "resources/notices",
        "to": "notices"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "packaging/installer.nsh",
      "installerLanguages": [
        "en_US"
      ],
      "language": "en_US"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "Zintriq Studio",
      "executableArgs": [],
      "maintainer": "Zintriq <support@zintriq.com>"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
