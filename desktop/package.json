{
  "name": "editor",
  "productName": "Zintriq Editor",
  "version": "0.1.0",
  "description": "Zintriq Editor — performance-first local code editor",
  "main": "main.js",
  "author": {
    "name": "Zintriq",
    "email": "support@zintriq.com"
  },
  "homepage": "https://zintriq.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "smoke": "node scripts/smoke.js",
    "rebuild:pty": "node scripts/rebuild-pty.js",
    "postinstall": "node scripts/rebuild-pty.js",
    "pack": "node packaging/run-builder.js --dir --publish never",
    "dist": "node packaging/run-builder.js --publish never",
    "dist:mac": "node packaging/run-builder.js --mac --publish never",
    "dist:win": "node packaging/run-builder.js --win --publish never",
    "dist:linux": "node packaging/run-builder.js --linux --publish never"
  },
  "build": {
    "appId": "com.editor",
    "productName": "Zintriq Editor",
    "copyright": "Copyright © Zintriq",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "main.js",
      "preload.js",
      "flask_host.js",
      "app_menu.js",
      "navigation.js",
      "host_prefs.js",
      "pty_host.js",
      "error.html",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/server",
        "to": "server"
      },
      {
        "from": "resources/notices",
        "to": "notices"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "Zintriq Editor",
      "maintainer": "Zintriq <support@zintriq.com>"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  }
}
